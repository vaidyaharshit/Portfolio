# ==========================================================================
# ENVIRONMENT TEMPLATE — HV PORTFOLIO
#
# IMPORTANT: This project is a static site with NO build step (no Vite, no
# bundler), so .env files are NOT read by anything. The single file the site
# actually loads is:
#
#     src/env.js          <-- PUT YOUR REAL KEY HERE
#
# You only ever edit that one file. Nothing else.
# ==========================================================================

# REQUIRED for the contact form:
#   1. Go to https://web3forms.com and enter your inbox address
#   2. Web3Forms emails you an Access Key (looks like a UUID)
#   3. Paste it into src/env.js on this line:
#        WEB3FORMS_ACCESS_KEY: 'paste-the-key-here',
WEB3FORMS_ACCESS_KEY=

# OPTIONAL: set to true in src/env.js to add an hCaptcha challenge
# (also enable "Block Spam -> hCaptcha" at web3forms.com/dashboard)
WEB3FORMS_CAPTCHA=

# OPTIONAL: GitHub Personal Access Token (window.GITHUB_TOKEN) for higher
# API rate limits. Create at https://github.com/settings/tokens
GITHUB_TOKEN=
